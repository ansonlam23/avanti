# Open Sign environment variables — NAMES ONLY. Real values go in .env.local
# (gitignored). Never paste keys into chat, commits, or issues.

# ── Gemini (Google AI Studio → Get API key) ───────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ── Supabase (Project Settings → API Keys, and Connect) ───────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Local migrations only (Connect → "Session pooler" URI, with your DB password).
# Never add this one to Vercel.
SUPABASE_DB_URL=

# ── Visa Acceptance (Cybersource) sandbox ─────────────────────────────
# Leave the VISA_* values blank and payments run in SIMULATED mode (clearly
# labeled in the UI). Set PAYMENTS_MODE=sandbox once the keys are in.
PAYMENTS_MODE=simulated
VISA_MERCHANT_ID=
VISA_KEY_ID=
VISA_SHARED_SECRET=
VISA_HOST=apitest.cybersource.com

# ── "Open Sign Shopper" agent signing key (Ed25519) ───────────────────
# Generated by `pnpm keys:agent` straight into .env.local. Don't hand-edit.
AGENT_KEY_ID=
AGENT_ED25519_PRIVATE_KEY=
AGENT_ED25519_PUBLIC_KEY=

# ── App ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
